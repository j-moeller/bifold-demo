+def _uv_of(model, head, k):
+    prim = model.primitives[0]
+    tri = np.asarray(prim.indices, np.int64).reshape(-1, 3)[head.triangle[k]]
+    return head.barycentric[k] @ np.asarray(prim.uvs, np.float64)[tri]
