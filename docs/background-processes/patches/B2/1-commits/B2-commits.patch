+        assert abs(float(fixed.mean()) - float(image.mean())) < 8  # the same fabric, not a new one
+    stripes = make_seamless(cases[2])  # the overlap keeps the rhythm: every stripe as wide as the others
+    profile = stripes[256, :, 0] > 128
