+    plain = cv2.resize(noise, (128, 128), interpolation=cv2.INTER_CUBIC)  # (cv2 repeats the edge pixels instead)
+    assert np.abs(cv2.resize(moved, (128, 128), interpolation=cv2.INTER_CUBIC) - np.roll(plain, (4, 8), (0, 1))).max() \
