+def test_the_repair_makes_any_image_tile_the_same_way_every_time():
+    x = np.arange(512, dtype=np.float32)
+    light = (0.75 + 0.5 * x / 511)[None, :, None] * (1.1 - 0.25 * (x / 511))[:, None, None]
+    cases = [cut_out(512, 8, 11), cut_out(512, 30, 12) * light,
