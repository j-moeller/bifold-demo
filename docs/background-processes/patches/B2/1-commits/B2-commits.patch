+def test_resizing_a_repeat_wraps_round_its_edges():
+    x = (np.arange(96) + 0.5) / 96
+    wave = np.repeat((128 + 100 * np.sin(2 * np.pi * x))[None, :, None], 96, axis=0).astype(np.float32)
+    big = resize_periodic(wave, 128, 96)
